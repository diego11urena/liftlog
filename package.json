{
  "name": "workout-log",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "build:exercises": "node --experimental-strip-types scripts/build-exercises.ts",
    "build:body": "node --experimental-strip-types scripts/build-body.ts",
    "check:exercises": "node --experimental-strip-types scripts/check-exercises.ts",
    "serve": "npm run build && node --experimental-strip-types --disable-warning=ExperimentalWarning server/index.ts",
    "start": "node --experimental-strip-types --disable-warning=ExperimentalWarning server/index.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "fastify": "^5.12.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@musclemap/assets": "^1.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
